# ─────────────────────────────────────────────────────────────────────────────
# AKABBO — Phase 0 environment template
# Copy to `.env` for local dev. NEVER commit a real .env (it is gitignored).
# In Cloud Run these are set as service env vars / secrets, not from a file.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime -----------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
# Which process this container runs. One of: api | worker
# (Set per Cloud Run service. Locally the npm scripts pick the process.)
APP_ROLE=api
# Port the API process listens on. Cloud Run injects PORT; default 8080.
PORT=8080
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database (Neon) ---------------------------------------------------------
# Pooled connection string for the app (PgBouncer endpoint, ...-pooler.<region>).
# Must include sslmode=require. See CREDENTIALS.md → Neon.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/akabbo?sslmode=require
# Direct (non-pooled) connection string — used only by `prisma migrate`.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/akabbo?sslmode=require

# --- Observability (Sentry) --------------------------------------------------
# Leave blank to disable Sentry (no-op). Set to enable error reporting.
SENTRY_DSN=
# Fraction of transactions traced (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Worker ------------------------------------------------------------------
# Heartbeat interval in milliseconds (Phase 0: proves the worker is alive).
WORKER_HEARTBEAT_MS=15000

# --- Auth (Phase 1) ----------------------------------------------------------
# Signs session JWTs. MUST be a strong random value in production (the app
# refuses to boot in production with the dev default). >= 16 chars.
JWT_SECRET=dev-insecure-secret-change-me-please
JWT_TTL_SECONDS=3600
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Dev only: return the OTP code in the API response (no SMS yet — that's Phase
# 3). MUST be false in production (boot is refused otherwise).
AUTH_EXPOSE_OTP=true

# ─────────────────────────────────────────────────────────────────────────────
# Provider credentials — Phase 0 ships STUB implementations only.
# These keys are placeholders documenting what later phases will require.
# Leave blank in Phase 0; the stub providers ignore them.
# ─────────────────────────────────────────────────────────────────────────────
# LLM (Phase 2) — Gemini primary, Claude fallback.
# 'stub' (default) keeps the app bootable with no key; the deterministic capture
# tier works regardless. Set 'gemini' + a key to enable the real LLM tier.
LLM_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# SMS (Phase 3) — UGSMS v2 (ugsms.com). Set SMS_PROVIDER=ugsms to enable.
SMS_PROVIDER=stub
UGSMS_BASE_URL=https://ugsms.com/api/v2
UGSMS_API_KEY=
UGSMS_SENDER_ID=AKABBO

# Payments (Phase 5) — Muda.tech MoMo collections. Set PAYMENT_PROVIDER=muda to enable.
PAYMENT_PROVIDER=stub
MUDA_BASE_URL=https://api.muda.tech/v1
MUDA_OAUTH_URL=
MUDA_CLIENT_ID=
MUDA_CLIENT_SECRET=
MUDA_COLLECTION_PRODUCT_ID=10012
MUDA_WEBHOOK_SECRET=

# Storage (Phase 4) — GCS for Cloud Run production; local for dev.
# Set STORAGE_PROVIDER=gcs + GCS_BUCKET + GCS_SERVICE_ACCOUNT_EMAIL for GCP.
# On Cloud Run the service account email is the identity of the Cloud Run service.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.akabbo-storage
GCS_BUCKET=
GCS_SERVICE_ACCOUNT_EMAIL=

# Auth (Phase 1) — phone-OTP provider behind our Auth interface
AUTH_PROVIDER=local
