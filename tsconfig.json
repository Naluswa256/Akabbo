{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "paths": {
      "@akabbo/config": ["libs/config/src"],
      "@akabbo/config/*": ["libs/config/src/*"],
      "@akabbo/logging": ["libs/logging/src"],
      "@akabbo/logging/*": ["libs/logging/src/*"],
      "@akabbo/observability": ["libs/observability/src"],
      "@akabbo/observability/*": ["libs/observability/src/*"],
      "@akabbo/prisma": ["libs/prisma/src"],
      "@akabbo/prisma/*": ["libs/prisma/src/*"],
      "@akabbo/providers": ["libs/providers/src"],
      "@akabbo/providers/*": ["libs/providers/src/*"],
      "@akabbo/access": ["libs/access/src"],
      "@akabbo/access/*": ["libs/access/src/*"],
      "@akabbo/identity": ["libs/identity/src"],
      "@akabbo/identity/*": ["libs/identity/src/*"],
      "@akabbo/ledger": ["libs/ledger/src"],
      "@akabbo/ledger/*": ["libs/ledger/src/*"],
      "@akabbo/ai": ["libs/ai/src"],
      "@akabbo/ai/*": ["libs/ai/src/*"],
      "@akabbo/documents": ["libs/documents/src"],
      "@akabbo/documents/*": ["libs/documents/src/*"],
      "@akabbo/transparency": ["libs/transparency/src"],
      "@akabbo/transparency/*": ["libs/transparency/src/*"],
      "@akabbo/billing": ["libs/billing/src"],
      "@akabbo/billing/*": ["libs/billing/src/*"],
      "@akabbo/comms": ["libs/comms/src"],
      "@akabbo/comms/*": ["libs/comms/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
